{
  "name": "music",
  "productName": "Music",
  "description": "跨平台音乐播放器，支持桌面/移动端悬浮歌词",
  "author": {
    "name": "icebear0828",
    "email": "mesolovealmomani521@gmail.com"
  },
  "homepage": "https://github.com/icebear0828/free-music",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "tsx server/server.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "esbuild server/server.ts --bundle --platform=node --target=node22 --outfile=dist/server.cjs --format=cjs --packages=external",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --target=node22 --outfile=dist-electron/main.cjs --format=cjs --external:electron --packages=external && esbuild electron/preload.ts electron/lyrics-preload.ts --bundle --platform=node --target=node22 --outdir=dist-electron --out-extension:.js=.cjs --format=cjs --external:electron",
    "start": "node dist/server.cjs",
    "dev:desktop": "npm run build:electron && concurrently -k -n server,electron -c blue,magenta \"npm run dev\" \"wait-on http-get://localhost:3000 && cross-env MUSIC_DEV_SERVER_URL=http://localhost:3000 electron .\"",
    "desktop": "npm run build && npm run build:electron && electron .",
    "dist:desktop": "npm run build && npm run build:electron && electron-builder --publish never",
    "dist:mac": "npm run build && npm run build:electron && electron-builder --mac --publish never",
    "dist:win": "npm run build && npm run build:electron && electron-builder --win --publish never",
    "dist:linux": "npm run build && npm run build:electron && electron-builder --linux --publish never",
    "mobile:sync": "npm run build:web && cap sync",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:ios": "npm run mobile:sync && cap open ios",
    "mobile:run:android": "npm run mobile:sync && cap run android",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-electron release",
    "lint": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.16.0",
    "big-integer": "^1.6.52",
    "cheerio": "^1.2.0",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.20",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "he": "^1.2.0",
    "localforage": "^1.10.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.6",
    "wait-on": "^8.0.5"
  }
}
